[configuration]

entry_symbol = "initialize_extension"
compatibility_minimum = "4.4"
reloadable = true
android_aar_plugin = true

[libraries]

linux.debug.double.x86_64 = "linux/libdiscord_social_sdk.linux.template_debug.double.x86_64.so"
linux.debug.x86_64 = "linux/libdiscord_social_sdk.linux.template_debug.x86_64.so"
linux.release.double.x86_64 = "linux/libdiscord_social_sdk.linux.template_release.double.x86_64.so"
linux.release.x86_64 = "linux/libdiscord_social_sdk.linux.template_release.x86_64.so"
windows.debug.double.x86_64 = "windows/discord_social_sdk.windows.template_debug.double.x86_64.dll"
windows.debug.x86_64 = "windows/discord_social_sdk.windows.template_debug.x86_64.dll"
windows.release.double.x86_64 = "windows/discord_social_sdk.windows.template_release.double.x86_64.dll"
windows.release.x86_64 = "windows/discord_social_sdk.windows.template_release.x86_64.dll"

[dependencies]

linux.debug.x86_64 = { "linux/libdiscord_partner_sdk.so": ""}
linux.release.x86_64 = { "linux/libdiscord_partner_sdk.so": ""}
windows.debug.x86_64 = { "windows/discord_partner_sdk.dll": "", "windows/discord_partner_sdk.lib": ""}
windows.release.x86_64 = { "windows/discord_partner_sdk.dll": "", "windows/discord_partner_sdk.lib": ""}
